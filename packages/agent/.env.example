# Written for you by `yarn agent:setup`. Fill in manually to use an existing agent and client.

# testnet | mainnet
HEDERA_NETWORK=testnet
# AgentBonds contract (defaults to packages/foundry/deployments/<chainId>.json)
BONDS_ADDRESS=
# The bonded agent's ECDSA private key (0x...): registers, posts its bond and publishes work receipts to HCS
AGENT_PRIVATE_KEY=
# The client's ECDSA private key (0x...): hires agents and disputes bad work
CLIENT_PRIVATE_KEY=
# Only for `yarn agent:chat` (or run `ant auth login` instead)
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default claude-opus-5-5)
CLAUDE_MODEL=
